PORT=8080
ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=oracle
DB_PASSWORD=oracle
DB_NAME=oracle
DB_SSLMODE=disable

# Cache shared by the API and the sync command (docker compose up -d starts it)
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=oracle:cache:

# Metrics are scraped by Prometheus on this port, apart from the API
# METRICS_PORT=9100
# Log format on stderr: text (default) or json
# LOG_FORMAT=json

# Traces and logs go to Tempo and Loki of the monitoring stack (make monitoring). Leave these
# unset to send nothing; metrics do not depend on them.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs
# Keep every trace (default) or a share of them, e.g. under load tests:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
