        {
          "name": "List the quotes of a ticker",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickers/:ticker/quotes?from=2026-10-29&to=2026-10-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickers",
                ":ticker",
                "quotes"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-10-29",
                  "description": "First day, included (YYYY-MM-DD). Optional."
                },
                {
                  "key": "to",
                  "value": "2026-10-30",
                  "description": "Last day, included (YYYY-MM-DD). Optional."
                }
              ],
              "variable": [
                {
                  "key": "ticker",
                  "value": "PETR4",
                  "description": "B3 ticker, case-insensitive."
                }
              ]
            },
            "description": "Daily quotes of one ticker, in date order. Prices are in BRL as traded, **not adjusted** for splits or dividends; `volume` is the traded value in BRL.\n\n`from` and `to` are optional and inclusive; without them the whole history is returned. A range without sessions answers `[]`.\n\nErrors: `400` when `from` or `to` is not `YYYY-MM-DD` or `from` is after `to`; `404` for a ticker without quotes. Read only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"body is JSON\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json\");",
                  "});",
                  "pm.test(\"quotes in date order\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  body.forEach(function (q, i) {",
                  "    pm.expect(q).to.have.all.keys(\"ticker\", \"name\", \"date\", \"open\", \"high\", \"low\", \"average\", \"close\", \"trades\", \"quantity\", \"volume\");",
                  "    if (i > 0) pm.expect(q.date > body[i - 1].date).to.be.true;",
                  "  });",
                  "});"
                ]
              }
            }
          ],
